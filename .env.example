# Proyecto Supabase: og-circle (sa-east-1) — ver docs/SUPABASE-SETUP.md
# Placeholder acá a propósito: aunque NEXT_PUBLIC_* viaja al bundle del cliente
# igual, no hace falta facilitar reconocimiento de infraestructura publicando
# la URL real del proyecto en un archivo de ejemplo del repo. Sacar el valor
# real de Project Settings → API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge Config store — pendiente vincular en Vercel (VGRP-39, docs/EDGE-CONFIG.md)
EDGE_CONFIG=

# Sitio: usado para armar back_urls absolutas de MercadoPago (éxito/pendiente/fallo)
# y los CTA de los emails transaccionales. En Preview Deployments, Vercel expone
# VERCEL_URL automáticamente — no hardcodear localhost acá.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout y webhook de Mercado Pago (VGRP-22, VGRP-23, PRD Fase 2 §5.1)
# Credenciales de PRUEBA (cuenta de test de MP), nunca las de producción en local.
MERCADOPAGO_ACCESS_TOKEN=
# Secreto para validar la firma HMAC del header x-signature en el webhook.
# Se obtiene en el panel de MP al configurar la notificación webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# Emails transaccionales — Resend (VGRP-25, docs/EMAIL.md)
# API key de Resend. Sin dominio verificado, Resend solo entrega a la casilla del
# dueño de la cuenta.
RESEND_API_KEY=
# Secreto del Send Email Hook de Supabase (Authentication → Hooks). Formato
# `v1,whsec_...`. ⚠️ NO registrar el hook hasta tener SPF y DKIM verificados:
# rompe la recuperación de contraseña de todos los usuarios. Ver docs/EMAIL.md.
SEND_EMAIL_HOOK_SECRET=
# Remitente y reply-to definitivos: DECISIÓN ABIERTA, dependen del dominio que se
# compre. Vacíos, se usa el remitente de prueba `onboarding@resend.dev`.
EMAIL_FROM=
EMAIL_REPLY_TO=

# Service role key del proyecto Supabase de arriba. Nunca debe llegar al bundle
# de cliente. Hasta VGRP-23 la usaban únicamente scripts de servidor (seed,
# tests, limpieza — VGRP-43, docs/TESTING.md); desde el Bloque 4 también la usa
# el webhook de Mercado Pago para escribir en `pagos` y proyectar `nivel`
# bypaseando RLS (VGRP-24a). Mientras el proyecto no facture, los tests corren
# contra este MISMO proyecto (no hay budget para una branch separada) — todo
# dato de test queda identificable (test/helpers/seed-users.ts) y con limpieza
# obligatoria (test/helpers/cleanup.ts).
# Sacarla de Project Settings → API → service_role, NUNCA commitear el valor.
SUPABASE_SERVICE_ROLE_KEY=
