# Proyecto Supabase: og-circle (sa-east-1) — ver docs/SUPABASE-SETUP.md
NEXT_PUBLIC_SUPABASE_URL=https://hsmodrhbwkromoixrxrt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge Config store — pendiente vincular en Vercel (VGRP-39, docs/EDGE-CONFIG.md)
EDGE_CONFIG=

# Emails transaccionales — Resend (VGRP-25, docs/EMAIL.md)
# API key de Resend. Sin dominio verificado, Resend solo entrega a la casilla del
# dueño de la cuenta.
RESEND_API_KEY=
# Secreto del Send Email Hook de Supabase (Authentication → Hooks). Formato
# `v1,whsec_...`. ⚠️ NO registrar el hook hasta tener SPF y DKIM verificados:
# rompe la recuperación de contraseña de todos los usuarios. Ver docs/EMAIL.md.
SEND_EMAIL_HOOK_SECRET=
# Remitente y reply-to definitivos: DECISIÓN ABIERTA, dependen del dominio que se
# compre. Vacíos, se usa el remitente de prueba `onboarding@resend.dev`.
EMAIL_FROM=
EMAIL_REPLY_TO=
